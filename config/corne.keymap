// Definisci layout specifico per Corne a 42 tasti
#define CONFIG_WIRELESS
#define LH2 LH  // Definizioni compatibili con la base keymap
#define RH2 RH

// Ridefinisci come il layout base viene adattato alla Corne
#define ZMK_BASE_LAYER(name, LT, RT, LM, RM, LB, RB, LH, RH)                   \
    ZMK_LAYER(                                                                 \
        name,                                                                  \
                 LT RT                                                         \
                 LM RM                                                         \
                 LB RB                                                         \
        &kp LGUI LH RH &smart_mouse                                            \
    )

// Includi le etichette dei tasti per Corne a 42 tasti
#include "zmk-helpers/key-labels/42.h"
// Includi il layout base
#include "base.keymap"
