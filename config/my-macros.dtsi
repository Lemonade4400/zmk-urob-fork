
ZMK_MACRO(double_down,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOWN &kp DOWN>;
)

ZMK_MACRO(triple_down,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOWN &kp DOWN &kp DOWN>;
)

ZMK_MACRO(four_down,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOWN &kp DOWN &kp DOWN &kp DOWN>;
)

