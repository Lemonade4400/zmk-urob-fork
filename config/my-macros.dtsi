
ZMK_MACRO(double_down,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOWN &kp DOWN>;
)

ZMK_MACRO(triple_down,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOWN &kp DOWN &kp DOWN>;
)

ZMK_MACRO(four_down,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOWN &kp DOWN &kp DOWN &kp DOWN>;
)

ZMK_MACRO(six_down,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN &kp DOWN>;
)

ZMK_MACRO(double_up,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp UP &kp UP>;
)

ZMK_MACRO(triple_up,
    wait-ms = <0>;
