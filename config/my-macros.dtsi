)

ZMK_MACRO(one_left,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = 
        <&macro_press &kp LCTRL>,
        <&macro_tap &kp LEFT>,
        <&macro_release &kp LCTRL>;
)

ZMK_MACRO(double_left,
    wait-ms = <0>;
