ZMK_MACRO(a_accent,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp SCROLLLOCK &kp APOS &kp A &kp SPACE>;
)

ZMK_MACRO(e_accent,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp SCROLLLOCK &kp APOS &kp E &kp SPACE>;
)

ZMK_MACRO(i_accent,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp SCROLLLOCK &kp APOS &kp I &kp SPACE>;
)

ZMK_MACRO(back,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = 
        <&macro_press &kp LALT>,
        <&macro_tap &kp LEFT>,
        <&macro_release &kp LALT>;
)

ZMK_MACRO(forward,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = 
        <&macro_press &kp LALT>,
        <&macro_tap &kp RIGHT>,
        <&macro_release &kp LALT>;
)

ZMK_MACRO(o_accent,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp SCROLLLOCK &kp APOS &kp O &kp SPACE>;
)

ZMK_MACRO(u_accent,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp SCROLLLOCK &kp APOS &kp U &kp SPACE>;
)

ZMK_TAP_DANCE(e_tap_dance,
    tapping-term-ms = <200>;
    bindings = <&e_accent>, <&kp F8>;
)

ZMK_TAP_DANCE(a_tap_dance,
    tapping-term-ms = <200>;
    bindings = <&a_accent>, <&kp F11>;
)

// tap: copy | double-tap: cut
ZMK_TAP_DANCE(copy_cut,
    tapping-term-ms = <200>;
    bindings = <&kp LC(INS)>, <&kp LC(X)>;
)

// not used!
// tap: < | double-tap: >
ZMK_TAP_DANCE(less_greater,
    tapping-term-ms = <200>;
    bindings = <&kp LS(COMMA)>, <&kp LS(DOT)>;
)

// not used!
ZMK_MACRO(select_line,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = 
        <&macro_tap &kp HOME>,
        <&macro_press &kp LSHFT>,
        <&macro_tap &kp END>,
        <&macro_release &kp LSHFT>;
)

// Tap: delete two words forward. Hold: keep LC(DEL) held so the host's own
// key-repeat keeps eating words for as long as the key is down.
ZMK_MACRO(del_two_words,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings =
        <&kp LC(DEL)>,
        <&macro_press &kp LC(DEL)>,
        <&macro_pause_for_release>,
        <&macro_release &kp LC(DEL)>;
)

// Tap: delete two words backward. Hold: keep LC(BSPC) held so the host's own
// key-repeat keeps eating words for as long as the key is down.
ZMK_MACRO(bspc_two_words,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings =
        <&kp LC(BSPC)>,
        <&macro_press &kp LC(BSPC)>,
        <&macro_pause_for_release>,
        <&macro_release &kp LC(BSPC)>;
)