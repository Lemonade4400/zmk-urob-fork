    bindings = <&kp UP &kp UP &kp UP>;
)

ZMK_MACRO(four_up,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = <&kp UP &kp UP &kp UP &kp UP>;
)

ZMK_MACRO(six_up,
    wait-ms = <0>;
