ZMK_MACRO(alt_shift_quote,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = 
        <&macro_press &kp RSHFT &kp RALT>,
        <&macro_tap &kp SQT>,
        <&macro_release &kp RSHFT &kp RALT>;
)


ZMK_MACRO(back,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = 
        <&macro_press &kp LALT>,
        <&macro_tap &kp LEFT>,
        <&macro_release &kp LALT>;
)

ZMK_MACRO(forward,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = 
        <&macro_press &kp LALT>,
        <&macro_tap &kp RIGHT>,
        <&macro_release &kp LALT>;
)


// Old Compose-key accent macros (replaced by ZMK_UNICODE_PAIR from italian.dtsi).
// These used Linux's Compose key (mapped to SCROLLLOCK) + dead key sequence to produce
// accented characters. Required: US International layout + SCROLLLOCK configured as
// Compose key in the desktop environment. Only worked on Linux with this specific setup.
//
// ZMK_MACRO(a_accent,
//     wait-ms = <0>;
//     tap-ms = <5>;
//     bindings = <&kp SCROLLLOCK &kp APOS &kp A>;  // Compose + ' + A = à
// )
//
// ZMK_MACRO(e_accent,
//     wait-ms = <0>;
//     tap-ms = <5>;
//     bindings = <&kp SCROLLLOCK &kp APOS &kp E>;  // Compose + ' + E = è
// )
//
// ZMK_MACRO(i_accent,
//     wait-ms = <0>;
//     tap-ms = <5>;
//     bindings = <&kp SCROLLLOCK &kp APOS &kp I>;  // Compose + ' + I = ì
// )
//
// ZMK_MACRO(o_accent,
//     wait-ms = <0>;
//     tap-ms = <5>;
//     bindings = <&kp SCROLLLOCK &kp APOS &kp O>;  // Compose + ' + O = ò
// )
//
// ZMK_MACRO(u_accent,
//     wait-ms = <0>;
//     tap-ms = <5>;
//     bindings = <&kp SCROLLLOCK &kp APOS &kp U>;  // Compose + ' + U = ù
// )

ZMK_TAP_DANCE(e_tap_dance,
    tapping-term-ms = <200>;
    bindings = <&it_e_grave>, <&kp F8>;
)

ZMK_TAP_DANCE(a_tap_dance,
    tapping-term-ms = <200>;
    bindings = <&it_a_grave>, <&kp F11>;
)

// tap: copy | double-tap: cut
ZMK_TAP_DANCE(copy_cut,
    tapping-term-ms = <200>;
    bindings = <&kp LC(INS)>, <&kp LC(X)>;
)

// tap: < | double-tap: >
ZMK_TAP_DANCE(less_greater,
    tapping-term-ms = <200>;
    bindings = <&kp LS(COMMA)>, <&kp LS(DOT)>;
)

// not used!
ZMK_MACRO(select_line,
    wait-ms = <0>;
    tap-ms = <5>;
    bindings = 
        <&macro_tap &kp HOME>,
        <&macro_press &kp LSHFT>,
        <&macro_tap &kp END>,
        <&macro_release &kp LSHFT>;
)

ZMK_MACRO(del_two_words,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = <&kp LC(DEL) &kp LC(DEL)>;
)

ZMK_MACRO(bspc_two_words,
    wait-ms = <0>;
    tap-ms = <10>;
    bindings = <&kp LC(BSPC) &kp LC(BSPC)>;
)